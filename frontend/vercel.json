{
  "rewrites": [
    {
      "source": "/php/(.*)",
      "destination": "https://davidvaldes.masterendaw.es/veridi_tienda_web/php/$1"
    },
    {
      "source": "/img/(.*)",
      "destination": "https://davidvaldes.masterendaw.es/veridi_tienda_web/img/$1"
    },
    {
      "source": "/imgnuevas/(.*)",
      "destination": "https://davidvaldes.masterendaw.es/veridi_tienda_web/imgnuevas/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
